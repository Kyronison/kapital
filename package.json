{
  "name": "kapital",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "sim": "tsx packages/sim/src/run.ts",
    "sim:check": "tsx packages/sim/src/run.ts --games 400 --check",
    "start": "node --disable-warning=ExperimentalWarning --import tsx packages/server/src/main.ts",
    "server": "node --disable-warning=ExperimentalWarning --import tsx packages/server/src/main.ts",
    "web": "pnpm --filter @kapital/web dev",
    "build:web": "pnpm --filter @kapital/web build",
    "sim:levels": "tsx packages/sim/src/levels.ts",
    "sim:table": "tsx packages/sim/src/table.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
