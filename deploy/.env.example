# Скопируйте в .env и заполните. Файл .env не попадает в git.

# Домен, на который указывает A-запись сервера. Caddy получит для него сертификат.
KAPITAL_DOMAIN=kapital.example.com
KAPITAL_PUBLIC_URL=https://kapital.example.com
NODE_ENV=production

# Ключ шифрования базы: 32 случайных байта в hex. Сгенерировать: openssl rand -hex 32
# Потеря ключа = потеря почт и сохранённых партий, храните его вместе с резервной копией.
KAPITAL_SECRET=

# Почта для кодов входа. Без SMTP вход по почте выключен.
# Яндекс 360: smtps://login@yandex.ru:пароль-приложения@smtp.yandex.ru:465
# Mail.ru:    smtps://login@mail.ru:пароль-приложения@smtp.mail.ru:465
KAPITAL_SMTP_URL=
KAPITAL_MAIL_FROM=Капитал <login@yandex.ru>

# Google: для сервера с игроками из России оставьте пустым. С 7 июля 2026 вход через зарубежные
# сервисы на российских сайтах штрафуется (КоАП 13.55), см. deploy/README.md, раздел «Сервер в России».
# https://console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application),
# Authorized redirect URI: https://kapital.example.com/api/auth/oauth/google/callback
KAPITAL_GOOGLE_ID=
KAPITAL_GOOGLE_SECRET=

# Яндекс ID: https://oauth.yandex.ru → создать приложение → «Веб-сервисы»,
# Redirect URI: https://kapital.example.com/api/auth/oauth/yandex/callback, доступ: почта и имя.
KAPITAL_YANDEX_ID=
KAPITAL_YANDEX_SECRET=

# Telegram: у @BotFather /newbot → токен; затем /setdomain → kapital.example.com. Имя бота без @.
KAPITAL_TELEGRAM_TOKEN=
KAPITAL_TELEGRAM_BOT=
